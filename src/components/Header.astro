---
// Site-wide header. Used inside BaseLayout so every page gets the same nav.

const kdpStoreUrl = ""; // TODO: paste your KDP/Amazon store URL here once published
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo">
      <img src="/favicon.png" alt="World Travel Picks" class="logo-mark" />
      <span class="logo-text">World Travel Picks</span>
    </a>

    <nav class="main-nav">
      <a href="/" class="active">Home</a>

      <div class="nav-dropdown" data-dropdown="books">
        <button class="nav-dropdown-trigger" aria-expanded="false">
          Books
          <svg width="10" height="6" viewBox="0 0 10 6" fill="none">
            <path
              d="M1 1L5 5L9 1"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
        <div class="nav-dropdown-menu">
          <a href="/books/kids-adventure-series">Kids Adventure Series</a>
          <a href="/books/explorer-series">Explorer Series</a>
        </div>
      </div>

      <div class="nav-dropdown" data-dropdown="categories">
        <button class="nav-dropdown-trigger" aria-expanded="false">
          Categories
          <svg width="10" height="6" viewBox="0 0 10 6" fill="none">
            <path
              d="M1 1L5 5L9 1"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
        <div class="nav-dropdown-menu">
          <a href="/destinations">Destinations</a>
          <a href="/guides">Guides</a>
        </div>
      </div>

      <a
        href={kdpStoreUrl || "#"}
        target="_blank"
        rel="noopener noreferrer"
        class="kdp-link"
      >
        KDP Store
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
          <path
            d="M3.5 8.5L8.5 3.5M8.5 3.5H4.5M8.5 3.5V7.5"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>

      <a href="/about-us">About Us</a>
      <a href="/contact-us">Contact</a>
    </nav>

    <div class="header-actions">
      <button class="icon-btn" aria-label="Search">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
          <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5"
          ></circle>
          <path
            d="M16 16L12.5 12.5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </svg>
      </button>

      <button
        class="theme-toggle"
        id="theme-toggle-btn"
        aria-label="Toggle dark mode"
      >
        <span class="theme-toggle-track">
          <span class="theme-toggle-thumb"></span>
        </span>
      </button>

      <button
        class="icon-btn mobile-only"
        aria-label="Open menu"
        id="mobile-menu-btn"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path
            d="M2 5H18M2 10H18M2 15H18"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .header-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: var(--space-sm) var(--space-md);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    flex-shrink: 0;
  }

  .logo-mark {
    width: 28px;
    height: 28px;
  }

  .logo-text {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    color: var(--color-text-strong);
    text-transform: uppercase;
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .main-nav > a {
    color: var(--color-text);
    opacity: 0.85;
    transition: opacity 0.15s ease;
  }

  .main-nav > a.active {
    opacity: 1;
    border-bottom: 2px solid var(--color-accent);
    padding-bottom: 2px;
  }

  .main-nav > a:hover {
    opacity: 1;
  }

  .kdp-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: none;
    border: none;
    color: var(--color-text);
    opacity: 0.85;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    padding: 0;
  }

  .nav-dropdown-trigger:hover {
    opacity: 1;
  }

  .nav-dropdown-menu {
    position: absolute;
    top: calc(100% + var(--space-sm));
    left: 0;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    min-width: 180px;
    padding: var(--space-xs);
    display: none;
    flex-direction: column;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .nav-dropdown.open .nav-dropdown-menu {
    display: flex;
  }

  .nav-dropdown-menu a {
    color: var(--color-text);
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    opacity: 1;
  }

  .nav-dropdown-menu a:hover {
    background-color: var(--color-surface-secondary);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .icon-btn {
    background: none;
    border: none;
    color: var(--color-text);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem;
  }

  .theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .theme-toggle-track {
    display: block;
    width: 38px;
    height: 20px;
    background-color: var(--color-surface-secondary);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    position: relative;
    transition: background-color 0.2s ease;
  }

  .theme-toggle-thumb {
    position: absolute;
    top: 1px;
    left: 1px;
    width: 16px;
    height: 16px;
    background-color: var(--color-button-bg);
    border-radius: 50%;
    transition: transform 0.2s ease;
  }

  :root[data-theme="dark"] .theme-toggle-thumb {
    transform: translateX(18px);
  }

  .mobile-only {
    display: none;
  }

  @media (max-width: 950px) {
    .main-nav {
      display: none;
    }
    .mobile-only {
      display: flex;
    }
  }
</style>

<script>
  // Dropdown toggles (works for both Books and Categories independently)
  const dropdowns = document.querySelectorAll(".nav-dropdown");

  dropdowns.forEach((dropdown) => {
    const trigger = dropdown.querySelector(".nav-dropdown-trigger");
    trigger?.addEventListener("click", (e) => {
      e.stopPropagation();
      const isCurrentlyOpen = dropdown.classList.contains("open");
      dropdowns.forEach((d) => {
        d.classList.remove("open");
        d.querySelector(".nav-dropdown-trigger")?.setAttribute(
          "aria-expanded",
          "false",
        );
      });
      if (!isCurrentlyOpen) {
        dropdown.classList.add("open");
        trigger.setAttribute("aria-expanded", "true");
      }
    });
  });

  document.addEventListener("click", () => {
    dropdowns.forEach((d) => {
      d.classList.remove("open");
      d.querySelector(".nav-dropdown-trigger")?.setAttribute(
        "aria-expanded",
        "false",
      );
    });
  });

  // Theme toggle button
  const themeBtn = document.getElementById("theme-toggle-btn");
  themeBtn?.addEventListener("click", () => {
    const current = document.documentElement.getAttribute("data-theme");
    const next = current === "dark" ? "light" : "dark";
    (window as any).setWtpTheme(next);
  });
</script>
