---
// Site-wide header. Used inside BaseLayout so every page gets the same nav.

const kdpStoreUrl = ""; // TODO: paste your KDP/Amazon store URL here once published
---

<header class="site-header">
  <div class="header-inner">
    <button
      class="icon-btn mobile-only mobile-menu-trigger"
      aria-label="Open menu"
      id="mobile-menu-btn-left"
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
        <path
          d="M2 5H18M2 10H18M2 15H18"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"></path>
      </svg>
    </button>

    <a href="/" class="logo">
      <span class="logo-text logo-text-full">World Travel Picks</span>
      <span class="logo-text logo-text-short">W-T-P</span>
    </a>

    <nav class="main-nav">
      <a href="/" class="active">Home</a>

      <div class="nav-dropdown" data-dropdown="categories">
        <button class="nav-dropdown-trigger" aria-expanded="false">
          Categories
          <svg width="10" height="6" viewBox="0 0 10 6" fill="none">
            <path
              d="M1 1L5 5L9 1"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
        <div class="nav-dropdown-menu">
          <a href="/destinations">Destinations</a>
          <a href="/guides">Guides</a>
          <a href="/books">Books</a>
        </div>
      </div>

      <a
        href={kdpStoreUrl || "#"}
        target="_blank"
        rel="noopener noreferrer"
        class="kdp-link"
      >
        KDP Store
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
          <path
            d="M3.5 8.5L8.5 3.5M8.5 3.5H4.5M8.5 3.5V7.5"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>

      <a href="/about-us">About Us</a>
      <a href="/contact-us">Contact</a>
    </nav>

    <div class="header-actions">
      <div class="header-search-wrap" id="header-search-wrap">
        <button class="icon-btn" aria-label="Search" id="header-search-btn">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
            <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5"
            ></circle>
            <path
              d="M16 16L12.5 12.5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"></path>
          </svg>
        </button>

        <div class="header-search-field" id="header-search-field">
          <svg width="16" height="16" viewBox="0 0 18 18" fill="none">
            <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5"
            ></circle>
            <path
              d="M16 16L12.5 12.5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"></path>
          </svg>
          <input
            type="text"
            id="header-search-input"
            placeholder="Search destinations, countries & travel guides..."
            autocomplete="off"
          />
          <button
            id="header-search-close"
            aria-label="Close search"
            type="button"
          >
            <svg width="16" height="16" viewBox="0 0 18 18" fill="none">
              <path
                d="M4 4L14 14M14 4L4 14"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"></path>
            </svg>
          </button>
        </div>

        <!-- This dropdown belongs ONLY to the header search box. It is
             positioned absolutely relative to .header-search-wrap (the
             closest positioned ancestor), so it always sits flush under
             #header-search-field and matches its width exactly, no matter
             what Hero's dropdown is doing. -->
        <div class="header-search-dropdown" id="header-search-dropdown">
          <p class="wtp-search-empty">
            Start typing to search destinations, guides, and books...
          </p>
        </div>
      </div>

      <button
        class="theme-toggle"
        id="theme-toggle-btn"
        aria-label="Toggle dark mode"
      >
        <span class="theme-toggle-track">
          <span class="theme-toggle-thumb"></span>
        </span>
      </button>
    </div>
  </div>

  <div class="mobile-drawer-overlay" id="mobile-drawer-overlay"></div>

  <div class="mobile-drawer" id="mobile-drawer">
    <div class="mobile-drawer-header">
      <span class="logo-text">World Travel Picks</span>
      <button class="icon-btn" id="mobile-drawer-close" aria-label="Close menu">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path
            d="M4 4L16 16M16 4L4 16"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>

    <nav class="mobile-drawer-nav">
      <a href="/">Home</a>

      <div class="mobile-accordion">
        <button class="mobile-accordion-trigger">
          Categories
          <svg width="10" height="6" viewBox="0 0 10 6" fill="none">
            <path
              d="M1 1L5 5L9 1"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
        <div class="mobile-accordion-content">
          <a href="/destinations">Destinations</a>
          <a href="/guides">Guides</a>
          <a href="/books">Books</a>
        </div>
      </div>

      <a href={kdpStoreUrl || "#"} target="_blank" rel="noopener noreferrer"
        >KDP Store ↗</a
      >
      <a href="/about-us">About Us</a>
      <a href="/contact-us">Contact</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .header-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: var(--space-sm) var(--space-md);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    flex-shrink: 0;
  }

  .logo-text {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    color: var(--color-text-strong);
    text-transform: uppercase;
  }

  .logo-text-short {
    display: none;
  }

  .mobile-menu-trigger {
    display: none;
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .main-nav > a {
    color: var(--color-text);
    opacity: 0.85;
    transition: opacity 0.15s ease;
  }

  .main-nav > a.active {
    opacity: 1;
    border-bottom: 2px solid var(--color-accent);
    padding-bottom: 2px;
  }

  .main-nav > a:hover {
    opacity: 1;
  }

  .kdp-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: none;
    border: none;
    color: var(--color-text);
    opacity: 0.85;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    padding: 0;
  }

  .nav-dropdown-trigger:hover {
    opacity: 1;
  }

  .nav-dropdown-menu {
    position: absolute;
    top: calc(100% + var(--space-sm));
    left: 0;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    min-width: 180px;
    padding: var(--space-xs);
    display: none;
    flex-direction: column;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .nav-dropdown.open .nav-dropdown-menu {
    display: flex;
  }

  .nav-dropdown-menu a {
    color: var(--color-text);
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    opacity: 1;
  }

  .nav-dropdown-menu a:hover {
    background-color: var(--color-surface-secondary);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  /* This wrap is the positioned ancestor for BOTH the expanding search
     field and its dropdown, so the dropdown's `position: absolute` is
     always relative to this box, wherever it sits in the header. */
  .header-search-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .header-search-field {
    display: none;
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    align-items: center;
    gap: 0.5rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.5rem 0.9rem;
    width: 320px;
    max-width: 60vw;
    z-index: 60;
    color: var(--color-text-muted);
  }

  .header-search-field.open {
    display: flex;
  }

  .header-search-field input {
    flex: 1;
    border: none;
    outline: none;
    background: none;
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-text);
  }

  #header-search-close {
    background: none;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    display: flex;
  }

  .header-search-wrap.open .icon-btn {
    display: none;
  }

  /* The header's own dropdown. Anchored to the same right edge and same
     width as #header-search-field (via matching right:0 + width), and
     positioned directly beneath it using top: 100% + a small gap. This
     is completely independent from Hero's dropdown — no shared element,
     no shared position. */
  .header-search-dropdown {
    display: none;
    position: absolute;
    /* .header-search-field is vertically centered inside .header-search-wrap
       via top:50%/translateY(-50%), so "100% of the wrap" is NOT the same
       as "bottom of the field". Anchor from the wrap's vertical center and
       push down by half the field's height plus a visible gap instead. */
    top: calc(50% + 24px);
    right: 0;
    width: 320px;
    max-width: 60vw;
    max-height: 70vh;
    overflow-y: auto;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
    z-index: 60;
    padding: var(--space-sm) var(--space-md) var(--space-md);
  }

  .header-search-dropdown.open {
    display: block;
  }

  .icon-btn {
    background: none;
    border: none;
    color: var(--color-text);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem;
  }

  .theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .theme-toggle-track {
    display: block;
    width: 38px;
    height: 20px;
    background-color: var(--color-surface-secondary);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    position: relative;
    transition: background-color 0.2s ease;
  }

  .theme-toggle-thumb {
    position: absolute;
    top: 1px;
    left: 1px;
    width: 16px;
    height: 16px;
    background-color: var(--color-button-bg);
    border-radius: 50%;
    transition: transform 0.2s ease;
  }

  :root[data-theme="dark"] .theme-toggle-thumb {
    transform: translateX(18px);
  }

  .mobile-only {
    display: none;
  }

  @media (max-width: 950px) {
    .main-nav {
      display: none;
    }
    .mobile-menu-trigger {
      display: flex;
    }
    .logo-text-full {
      display: none;
    }
    .logo-text-short {
      display: inline;
    }
  }

  /* Mobile: the expanding field must take over the FULL navbar row width,
     not just the width of .header-search-wrap (which is only as wide as
     the search icon itself). Since .header-search-wrap is a small flex
     child, left:0/right:0 on an absolutely-positioned child of IT only
     spans that small wrap — not the screen. So on mobile we switch the
     field (and its dropdown) to `position: fixed`, pinned to the actual
     viewport edges, sitting right below the header bar. This matches the
     "icon -> full-width bar -> dropdown flush underneath, same width"
     behavior from the sketch. */
  @media (max-width: 700px) {
    .header-search-field {
      position: fixed;
      /* top is set exactly in JS (to the header's real rendered height) —
         this value is just a fallback before JS runs. */
      top: 56px;
      left: 0;
      right: 0;
      transform: none;
      width: auto;
      max-width: none;
      border-radius: 0;
      border-left: none;
      border-right: none;
      border-top: none;
      padding: 0.7rem var(--space-md);
      z-index: 65;
    }

    .header-search-dropdown {
      position: fixed;
      /* top is set exactly in JS (header height + field height) — this
         value is just a fallback before JS runs. */
      top: 108px;
      left: 0;
      right: 0;
      width: auto;
      max-width: none;
      max-height: calc(100vh - 108px);
      border-radius: 0;
      border-left: none;
      border-right: none;
      z-index: 64;
    }
  }

  /* --- Mobile drawer --- */
  .mobile-drawer-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.4);
    z-index: 90;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .mobile-drawer-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-drawer {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 300px;
    max-width: 85vw;
    background-color: var(--color-surface);
    z-index: 100;
    transform: translateX(-100%);
    transition: transform 0.25s ease;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }

  .mobile-drawer.open {
    transform: translateX(0);
  }

  .mobile-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-sm) var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-drawer-header .logo-text {
    color: var(--color-text-strong);
  }

  .mobile-drawer-nav {
    display: flex;
    flex-direction: column;
    padding: var(--space-sm) var(--space-md);
    font-family: var(--font-body);
    font-size: 0.95rem;
  }

  .mobile-drawer-nav > a {
    color: var(--color-text);
    padding: var(--space-xs) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-accordion {
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-accordion-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: none;
    border: none;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 0.95rem;
    padding: var(--space-xs) 0;
    cursor: pointer;
  }

  .mobile-accordion-trigger svg {
    transition: transform 0.2s ease;
  }

  .mobile-accordion.open .mobile-accordion-trigger svg {
    transform: rotate(180deg);
  }

  .mobile-accordion-content {
    display: none;
    flex-direction: column;
    padding-left: var(--space-sm);
    padding-bottom: var(--space-xs);
  }

  .mobile-accordion.open .mobile-accordion-content {
    display: flex;
  }

  .mobile-accordion-content a {
    color: var(--color-text-muted);
    padding: 0.4rem 0;
  }
</style>

<script>
  // Dropdown toggles (works for both Books and Categories independently)
  const dropdowns = document.querySelectorAll(".nav-dropdown");

  dropdowns.forEach((dropdown) => {
    const trigger = dropdown.querySelector(".nav-dropdown-trigger");
    trigger?.addEventListener("click", (e) => {
      e.stopPropagation();
      const isCurrentlyOpen = dropdown.classList.contains("open");
      dropdowns.forEach((d) => {
        d.classList.remove("open");
        d.querySelector(".nav-dropdown-trigger")?.setAttribute(
          "aria-expanded",
          "false",
        );
      });
      if (!isCurrentlyOpen) {
        dropdown.classList.add("open");
        trigger.setAttribute("aria-expanded", "true");
      }
    });
  });

  document.addEventListener("click", () => {
    dropdowns.forEach((d) => {
      d.classList.remove("open");
      d.querySelector(".nav-dropdown-trigger")?.setAttribute(
        "aria-expanded",
        "false",
      );
    });
  });

  // Theme toggle button
  const themeBtn = document.getElementById("theme-toggle-btn");
  themeBtn?.addEventListener("click", () => {
    const current = document.documentElement.getAttribute("data-theme");
    const next = current === "dark" ? "light" : "dark";
    (window as any).setWtpTheme(next);
  });

  // --- Header search: fully self-contained -----------------------------
  const searchWrap = document.getElementById("header-search-wrap");
  const searchBtn = document.getElementById("header-search-btn");
  const searchField = document.getElementById("header-search-field");
  const searchInput = document.getElementById(
    "header-search-input",
  ) as HTMLInputElement;
  const searchCloseBtn = document.getElementById("header-search-close");
  const searchDropdown = document.getElementById("header-search-dropdown");

  // On mobile, the expanding field and its dropdown are `position: fixed`
  // (see the max-width:700px block above), so they need their exact `top`
  // set from the real, rendered header height — not a guessed pixel value
  // that would drift if the header's padding/logo size ever changes.
  function positionMobileSearchFixed() {
    const header = document.querySelector(".site-header") as HTMLElement;
    if (!header || !searchField || !searchDropdown) return;
    const headerHeight = header.getBoundingClientRect().height;
    searchField.style.top = `${headerHeight}px`;
    // Field height is only known once it's visible (display: flex), which
    // happens right before this runs in openHeaderField().
    const fieldHeight = searchField.getBoundingClientRect().height;
    searchDropdown.style.top = `${headerHeight + fieldHeight}px`;
    searchDropdown.style.maxHeight = `calc(100vh - ${headerHeight + fieldHeight}px)`;
  }

  function openHeaderField() {
    searchWrap?.classList.add("open");
    searchField?.classList.add("open");
    // Position AFTER adding .open so getBoundingClientRect() reads the
    // field's real, visible height rather than 0 (display: none).
    requestAnimationFrame(positionMobileSearchFixed);
    setTimeout(() => searchInput?.focus(), 50);
  }

  function closeHeaderSearch() {
    searchWrap?.classList.remove("open");
    searchField?.classList.remove("open");
    searchDropdown?.classList.remove("open");
    if (searchInput) searchInput.value = "";
  }

  function openHeaderDropdown() {
    searchDropdown?.classList.add("open");
  }

  function closeHeaderDropdown() {
    searchDropdown?.classList.remove("open");
  }

  searchBtn?.addEventListener("click", openHeaderField);
  searchCloseBtn?.addEventListener("click", closeHeaderSearch);

  searchInput?.addEventListener("input", () => {
    const query = searchInput.value;
    if (searchDropdown) {
      searchDropdown.innerHTML =
        (window as any).__wtpSearch?.renderResultsHTML(query) || "";
    }
    if (query.trim()) {
      openHeaderDropdown();
    } else {
      closeHeaderDropdown();
    }
  });

  // Re-open the dropdown on focus if there's already a query typed
  // (e.g. user clicked away and back into the field without clearing it).
  searchInput?.addEventListener("focus", () => {
    if (searchInput.value.trim()) openHeaderDropdown();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && searchField?.classList.contains("open")) {
      closeHeaderSearch();
    }
  });

  window.addEventListener("resize", () => {
    if (searchField?.classList.contains("open")) {
      positionMobileSearchFixed();
    }
  });

  // Outside click: closes the dropdown (and the whole expanding field)
  // ONLY when the click is outside this header's own search wrap.
  // Uses mousedown so it fires before any focus/blur races.
  document.addEventListener("mousedown", (e) => {
    if (!searchWrap?.classList.contains("open")) return;
    const target = e.target as Node;
    if (!searchWrap.contains(target)) {
      closeHeaderSearch();
    }
  });

  // Mobile drawer open/close
  const drawer = document.getElementById("mobile-drawer");
  const overlay = document.getElementById("mobile-drawer-overlay");
  const openBtn = document.getElementById("mobile-menu-btn-left");
  const closeBtn = document.getElementById("mobile-drawer-close");

  function openDrawer() {
    drawer?.classList.add("open");
    overlay?.classList.add("open");
    document.body.style.overflow = "hidden";
  }

  function closeDrawer() {
    drawer?.classList.remove("open");
    overlay?.classList.remove("open");
    document.body.style.overflow = "";
  }

  openBtn?.addEventListener("click", openDrawer);
  closeBtn?.addEventListener("click", closeDrawer);
  overlay?.addEventListener("click", closeDrawer);

  // Mobile accordions (Books / Categories expand inline)
  document.querySelectorAll(".mobile-accordion-trigger").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      trigger.parentElement?.classList.toggle("open");
    });
  });
</script>
