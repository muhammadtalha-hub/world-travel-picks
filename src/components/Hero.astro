---
// Homepage hero section. Uses Astro's built-in Image component for
// automatic optimization: modern formats (WebP), correct sizing,
// and no layout shift while loading.

import { Image } from "astro:assets";

const {
  eyebrow = "YOUR TRAVEL RESEARCH HUB",
  heading = "Discover the World Differently",
  subtext = "Research-driven guides to remarkable places, unforgettable journeys, and stories worth exploring.",
  imageUrl,
  imageAlt = "A traveler looking out over mountains and a lake",
  popularSearches = [
    "Japan",
    "Switzerland",
    "Iceland",
    "Italy",
    "Thailand",
    "Portugal",
  ],
} = Astro.props;
---

<section class="hero">
  <Image
    src={imageUrl}
    alt={imageAlt}
    width={1600}
    height={700}
    format="webp"
    quality={80}
    class="hero-bg"
  />
  <div class="hero-overlay"></div>

  <div class="hero-content">
    <p class="hero-eyebrow">{eyebrow}</p>
    <h1 class="hero-heading">{heading}</h1>
    <p class="hero-subtext">{subtext}</p>

    <!-- .hero-search-wrap is the positioned ancestor for the dropdown
         below, so the dropdown always sits flush under this exact box
         and matches its exact width — fully independent of the header's
         own dropdown. -->
    <div class="hero-search-wrap" id="hero-search-wrap">
      <div class="hero-search">
        <input
          type="text"
          placeholder="Search destinations, countries & travel guides..."
          class="hero-search-input"
          id="hero-search-input"
          autocomplete="off"
        />
        <button
          class="hero-search-btn"
          aria-label="Search"
          id="hero-search-btn"
        >
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
            <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5"
            ></circle>
            <path
              d="M16 16L12.5 12.5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"></path>
          </svg>
        </button>
      </div>

      <div class="hero-search-dropdown" id="hero-search-dropdown">
        <p class="wtp-search-empty">
          Start typing to search destinations, guides, and books...
        </p>
      </div>
    </div>

    <div class="hero-popular">
      <span>Popular searches:</span>
      {
        popularSearches.map((term: string) => (
          <a href={`/search?q=${encodeURIComponent(term)}`} class="hero-tag">
            {term}
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 480px;
    display: flex;
    align-items: center;
    /* No overflow:hidden here. The background <Image> already clips
       itself via object-fit:cover on its own box, so this wrapper doesn't
       need to clip anything — and if it did, it would also clip the
       search dropdown below (which needs to visually extend past this
       section), no matter how high that dropdown's z-index is set. */
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(20, 21, 21, 0.75) 0%,
      rgba(20, 21, 21, 0.35) 55%,
      rgba(20, 21, 21, 0.1) 100%
    );
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 1400px;
    margin: 0 auto;
    padding: var(--space-xl) var(--space-md);
    width: 100%;
  }

  .hero-eyebrow {
    color: var(--color-accent);
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: var(--space-xs);
  }

  .hero-heading {
    color: #ffffff;
    font-size: 3rem;
    max-width: 600px;
    margin-bottom: var(--space-sm);
  }

  .hero-subtext {
    color: rgba(255, 255, 255, 0.85);
    max-width: 500px;
    margin-bottom: var(--space-md);
  }

  /* Positioned ancestor for .hero-search-dropdown. Same max-width as the
     search box itself so the dropdown never exceeds the box's width. */
  .hero-search-wrap {
    position: relative;
    max-width: 600px;
    margin-bottom: var(--space-sm);
  }

  .hero-search {
    display: flex;
    background-color: #ffffff;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .hero-search-input {
    flex: 1;
    border: none;
    padding: 0.9rem 1.1rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--color-text);
    outline: none;
  }

  .hero-search-btn {
    background-color: var(--color-button-bg);
    color: var(--color-button-text);
    border: none;
    padding: 0 1.3rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Hero's own dropdown. Anchored to .hero-search-wrap, spans its full
     width (left:0; right:0 within that wrap), opens directly beneath the
     search box with a small gap. Independent from the header's dropdown
     — no shared element, no shared position, no shared open/close state. */
  .hero-search-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    max-height: 70vh;
    overflow-y: auto;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
    /* Must beat .site-header's sticky z-index (50) so the dropdown always
       renders on top of the header row, not behind/under it. */
    z-index: 120;
    padding: var(--space-sm) var(--space-md) var(--space-md);
  }

  .hero-search-dropdown.open {
    display: block;
  }

  .hero-popular {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-xs);
    font-family: var(--font-body);
    font-size: 0.85rem;
  }

  .hero-popular > span {
    color: rgba(255, 255, 255, 0.75);
    margin-right: 0.2rem;
  }

  .hero-tag {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.15);
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    font-size: 0.8rem;
    transition: background-color 0.15s ease;
  }

  .hero-tag:hover {
    background-color: rgba(255, 255, 255, 0.25);
  }

  @media (max-width: 700px) {
    .hero-heading {
      font-size: 2rem;
    }
  }
</style>

<script>
  const heroSearchWrap = document.getElementById("hero-search-wrap");
  const heroSearchInput = document.getElementById(
    "hero-search-input",
  ) as HTMLInputElement;
  const heroSearchBtn = document.getElementById("hero-search-btn");
  const heroSearchDropdown = document.getElementById("hero-search-dropdown");

  function openHeroDropdown() {
    heroSearchDropdown?.classList.add("open");
  }

  function closeHeroDropdown() {
    heroSearchDropdown?.classList.remove("open");
  }

  function updateHeroResults(query: string) {
    if (heroSearchDropdown) {
      heroSearchDropdown.innerHTML =
        (window as any).__wtpSearch?.renderResultsHTML(query) || "";
    }
  }

  heroSearchInput?.addEventListener("input", () => {
    const query = heroSearchInput.value;
    updateHeroResults(query);
    if (query.trim()) {
      openHeroDropdown();
    } else {
      closeHeroDropdown();
    }
  });

  heroSearchInput?.addEventListener("focus", () => {
    if (heroSearchInput.value.trim()) openHeroDropdown();
  });

  heroSearchBtn?.addEventListener("click", () => {
    updateHeroResults(heroSearchInput?.value || "");
    openHeroDropdown();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeHeroDropdown();
  });

  // Outside click closes ONLY the hero dropdown, and only when the click
  // is outside this hero search wrap specifically.
  document.addEventListener("mousedown", (e) => {
    if (!heroSearchDropdown?.classList.contains("open")) return;
    const target = e.target as Node;
    if (heroSearchWrap && !heroSearchWrap.contains(target)) {
      closeHeroDropdown();
    }
  });
</script>
