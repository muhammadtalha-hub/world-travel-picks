---
// Reusable card — used for Destinations, Guides, Books, and Articles.
// Pass in the props below to customize each card's content.

const {
  image,
  tag,        // e.g. "Japan" or "Kids Adventure Series"
  title,
  meta,       // e.g. "7 min read · Aug 21, 2026" or "28 Guides"
  href = "#"
} = Astro.props;
---

<a href={href} class="card">
  <div class="card-image-wrap">
    <img src={image} alt={title} loading="lazy" />
    {tag && <span class="card-tag">{tag}</span>}
  </div>
  <div class="card-body">
    <h3 class="card-title">{title}</h3>
    {meta && <p class="card-meta">{meta}</p>}
  </div>
</a>

<style>
  .card {
    display: block;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
  }

  .card-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: var(--color-border);
  }

  .card-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-tag {
    position: absolute;
    top: var(--space-xs);
    left: var(--space-xs);
    background-color: var(--color-bg-dark);
    color: var(--color-text-on-dark);
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
  }

  .card-body {
    padding: var(--space-sm);
  }

  .card-title {
    font-size: 1.1rem;
    margin-bottom: var(--space-xs);
  }

  .card-meta {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0;
  }
</style>