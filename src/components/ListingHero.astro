---
// Shared hero banner for all three listing pages (Destinations, Guides, Books).
// Same visual structure everywhere — only the text and search action differ.

const {
  eyebrow, // e.g. "DESTINATIONS"
  heading, // e.g. "Explore the World"
  description,
} = Astro.props;
---

<section class="listing-hero">
  <div class="listing-hero-inner">
    <p class="listing-eyebrow">{eyebrow}</p>
    <h1>{heading}</h1>
    <p class="listing-desc">{description}</p>
  </div>
</section>

<style>
  .listing-hero {
    background-color: var(--color-bg-dark);
    padding: var(--space-lg) var(--space-md);
  }

  .listing-hero-inner {
    max-width: 1400px;
    margin: 0 auto;
  }

  .listing-eyebrow {
    color: var(--color-accent);
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: var(--space-xs);
  }

  .listing-hero h1 {
    color: #ffffff;
    font-size: 2.2rem;
    max-width: 600px;
    margin-bottom: var(--space-xs);
  }

  .listing-desc {
    color: rgba(255, 255, 255, 0.8);
    max-width: 550px;
    margin: 0;
  }
</style>
