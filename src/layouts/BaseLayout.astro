---
// This layout wraps every page on the site.
// It defines the shared <head>, favicon, fonts, and global styles.

import '../styles/global.css';

const { title = "World Travel Picks", description = "Discover the World Differently" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>