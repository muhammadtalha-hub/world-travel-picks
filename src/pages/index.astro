---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import FeatureStrip from "../components/FeatureStrip.astro";
import HomeFeaturedRow from "../components/HomeFeaturedRow.astro";
import CardRow from "../components/CardRow.astro";
import { getArticlesBySection, getCardDisplayTags } from "../utils/articles";

const destinationArticles = await getArticlesBySection("Destinations");
const booksArticles = await getArticlesBySection("Books");
import ExploreWorld from "../components/ExploreWorld.astro";
import heroHomeImage from "../assets/images/hero-home.jpg";
---

<BaseLayout title="World Travel Picks — Discover the World Differently">
  <main>
    <Hero
      imageUrl={heroHomeImage}
      imageAlt="A traveler looking out over mountains and a lake at sunrise"
    />
    <FeatureStrip />
    <HomeFeaturedRow />

    <CardRow
      heading="Destinations"
      viewAllHref="/destinations"
      items={destinationArticles.map((article) => ({
        image: article.data.coverImage,
        tag: getCardDisplayTags(article).join(" · "),
        title: article.data.title,
        meta: `${article.data.readTime} · ${article.data.publishDate.toDateString()}`,
        href: `/articles/${article.id}`,
      }))}
    />

    <CardRow
      heading="KDP Books Articles"
      viewAllHref="/books"
      items={booksArticles.map((article) => ({
        image: article.data.coverImage,
        tag: getCardDisplayTags(article).join(" · "),
        title: article.data.title,
        meta: `${article.data.readTime} · ${article.data.publishDate.toDateString()}`,
        href: `/articles/${article.id}`,
      }))}
    />

    <ExploreWorld />
  </main>
</BaseLayout>
