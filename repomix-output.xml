<file path="src/layouts/BaseLayout.astro">
---
// This layout wraps every page on the site.
// It defines the shared <head>, favicon, fonts, and global styles.

import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SearchOverlay from "../components/SearchOverlay.astro";

const {
  title = "World Travel Picks",
  description = "Discover the World Differently",
  image = "/favicon.png",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="description" content={description} />

    <!-- Open Graph tags — control how this page looks when shared on
         Facebook, WhatsApp, X, Discord, iMessage, etc. -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <title>{title}</title>
  </head>
  <body>
    <script is:inline>
      // Runs immediately, before page paint, to avoid a flash of wrong theme.
      const savedTheme = localStorage.getItem("wtp-theme");
      const prefersDark = window.matchMedia(
        "(prefers-color-scheme: dark)",
      ).matches;
      const theme = savedTheme || (prefersDark ? "dark" : "light");
      document.documentElement.setAttribute("data-theme", theme);

      // Makes the toggle button (built in Phase 2) able to call this
      // and have the choice remembered across refreshes.
      window.setWtpTheme = function (newTheme) {
        document.documentElement.setAttribute("data-theme", newTheme);
        localStorage.setItem("wtp-theme", newTheme);
      };
    </script>
    <Header />
    <slot />
    <Footer />
    <SearchOverlay />
  </body>
</html>
</file>

