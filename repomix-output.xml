---
// Homepage hero section. Uses Astro's built-in Image component for
// automatic optimization: modern formats (WebP), correct sizing,
// and no layout shift while loading.

import { Image } from "astro:assets";

const {
  eyebrow = "YOUR TRAVEL RESEARCH HUB",
  heading = "Discover the World Differently",
  subtext = "Research-driven guides to remarkable places, unforgettable journeys, and stories worth exploring.",
  imageUrl,
  imageAlt = "A traveler looking out over mountains and a lake",
  popularSearches = [
    "Japan",
    "Switzerland",
    "Iceland",
    "Italy",
    "Thailand",
    "Portugal",
  ],
} = Astro.props;
---

<section class="hero">
  <Image
    src={imageUrl}
    alt={imageAlt}
    width={1600}
    height={700}
    format="webp"
    quality={80}
    class="hero-bg"
  />
  <div class="hero-overlay"></div>

  <div class="hero-content">
    <p class="hero-eyebrow">{eyebrow}</p>
    <h1 class="hero-heading">{heading}</h1>
    <p class="hero-subtext">{subtext}</p>

    <div class="hero-search">
      <input
        type="text"
        placeholder="Search destinations, countries & travel guides..."
        class="hero-search-input"
        id="hero-search-input"
      />
      <button class="hero-search-btn" aria-label="Search" id="hero-search-btn">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
