<file path="src/pages/books.astro">
---
import BaseLayout from "../layouts/BaseLayout.astro";
import ListingHero from "../components/ListingHero.astro";
import ListingFilterBar from "../components/ListingFilterBar.astro";
import Card from "../components/Card.astro";
import ComingSoon from "../components/ComingSoon.astro";
import { getArticlesBySection, getCardDisplayTags } from "../utils/articles";
import heroBooksImage from "../assets/images/hero-books.jpg";

const articles = await getArticlesBySection("Books");

const sortedArticles = [...articles].sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const hasArticles = sortedArticles.length > 0;
---

<BaseLayout title="Books — World Travel Picks">
  <ListingHero
    eyebrow="Travel Books"
    heading="Books for Every Explorer"
    description="Curated travel books, inspiring stories, and practical guides to fuel your wanderlust and deepen your journeys."
    imageUrl={heroBooksImage}
    imageAlt="A stack of travel books, representing books for explorers"
  />

  <ListingFilterBar showSeries={true} />

  <section class="listing-content">
    {
      hasArticles ? (
        <>
          <p class="listing-count" id="listing-count">
            Showing {sortedArticles.length} of {sortedArticles.length} books
          </p>

          <div class="listing-grid" id="listing-grid">
            {sortedArticles.map((article) => (
              <div
                class="listing-card-wrap"
                data-title={article.data.title.toLowerCase()}
                data-tags={getCardDisplayTags(article).join(" ").toLowerCase()}
                data-date={article.data.publishDate.toISOString()}
              >
                <Card
                  image={article.data.coverImage}
                  tag={getCardDisplayTags(article).join(" · ")}
                  title={article.data.title}
                  meta={`${article.data.readTime} · ${article.data.publishDate.toDateString()}`}
                  href={`/articles/${article.id}`}
                />
              </div>
            ))}
          </div>

          <p class="no-results-msg" id="no-results-msg" style="display: none;">
            No books match your search.
          </p>
        </>
      ) : (
        <ComingSoon
          title="Books Coming Soon"
          message="We're preparing exciting travel books for young explorers and adventurers alike. Check back soon!"
        />
      )
    }
  </section>
</BaseLayout>

<style>
  .listing-content {
    max-width: 1400px;
    margin: 0 auto;
    padding: var(--space-md);
  }

  .listing-count {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .listing-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-sm);
  }

  .listing-grid.view-list {
    grid-template-columns: 1fr;
  }

  .listing-grid.view-list .listing-card-wrap :global(.card) {
    display: flex;
    flex-direction: row;
    align-items: stretch;
  }

  .listing-grid.view-list .listing-card-wrap :global(.card-image-wrap) {
    width: 240px;
    flex-shrink: 0;
    aspect-ratio: auto;
  }

  .listing-grid.view-list .listing-card-wrap :global(.card-body) {
    flex: 1;
  }

  @media (max-width: 700px) {
    .listing-grid.view-list .listing-card-wrap :global(.card) {
      flex-direction: column;
    }
    .listing-grid.view-list .listing-card-wrap :global(.card-image-wrap) {
      width: 100%;
    }
  }

  .no-results-msg {
    text-align: center;
    color: var(--color-text-muted);
    padding: var(--space-xl) 0;
  }

  @media (max-width: 1100px) {
    .listing-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .listing-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const grid = document.getElementById("listing-grid");
  const countLabel = document.getElementById("listing-count");
  const noResultsMsg = document.getElementById("no-results-msg");

  function getCardWraps(): HTMLElement[] {
    return grid ? Array.from(grid.querySelectorAll(".listing-card-wrap")) : [];
  }

  function updateCount(visibleCount: number, total: number) {
    if (countLabel) {
      countLabel.textContent = `Showing ${visibleCount} of ${total} books`;
    }
    if (noResultsMsg) {
      noResultsMsg.style.display = visibleCount === 0 ? "block" : "none";
    }
  }

  function applySearch(query: string) {
    const cards = getCardWraps();
    const lowerQuery = query.toLowerCase().trim();
    let visibleCount = 0;

    cards.forEach((card) => {
      const title = card.dataset.title || "";
      const tags = card.dataset.tags || "";
      const matches =
        !lowerQuery || title.includes(lowerQuery) || tags.includes(lowerQuery);
      card.style.display = matches ? "" : "none";
      if (matches) visibleCount++;
    });

    updateCount(visibleCount, cards.length);
  }

  function applySort(order: string) {
    if (!grid) return;
    const cards = getCardWraps();
    cards.sort((a, b) => {
      const dateA = new Date(a.dataset.date || "").getTime();
      const dateB = new Date(b.dataset.date || "").getTime();
      return order === "oldest" ? dateA - dateB : dateB - dateA;
    });
    cards.forEach((card) => grid.appendChild(card));
  }

  function applyRegion(region: string) {
    const lowerRegion = region.toLowerCase();
    const cards = getCardWraps();
    let visibleCount = 0;

    cards.forEach((card) => {
      const tags = card.dataset.tags || "";
      const matches =
        lowerRegion === "all regions" || tags.includes(lowerRegion);
      card.style.display = matches ? "" : "none";
      if (matches) visibleCount++;
    });

    updateCount(visibleCount, cards.length);
  }

  document.addEventListener("listing-search-change", ((e: CustomEvent) => {
    applySearch(e.detail);
  }) as EventListener);

  document.addEventListener("listing-sort-change", ((e: CustomEvent) => {
    applySort(e.detail);
  }) as EventListener);

  document.addEventListener("listing-region-change", ((e: CustomEvent) => {
    applyRegion(e.detail);
  }) as EventListener);

  document.addEventListener("listing-series-change", ((e: CustomEvent) => {
    const series = e.detail.toLowerCase();
    const cards = getCardWraps();
    let visibleCount = 0;

    cards.forEach((card) => {
      const tags = card.dataset.tags || "";
      const matches = series === "all series" || tags.includes(series);
      card.style.display = matches ? "" : "none";
      if (matches) visibleCount++;
    });

    updateCount(visibleCount, cards.length);
  }) as EventListener);

  document.addEventListener("listing-view-change", ((e: CustomEvent) => {
    grid?.classList.toggle("view-list", e.detail === "list");
  }) as EventListener);
</script>
</file>

<file path="src/styles/global.css">
/* ==========================================================================
   WORLD TRAVEL PICKS — GLOBAL DESIGN SYSTEM
   This file is the single source of truth for colors, fonts, and spacing.
   Every other file references these variables instead of hardcoding values.
   ========================================================================== */

/* --- Fonts (loaded from Google Fonts) --- */
@import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Inter:wght@400;500;600;700&family=Caveat:wght@500;600&display=swap');

:root {
  /* --- Colors (Light theme) --- */
  --color-bg: #F5F5F5;
  --color-bg-dark: #141515;
  --color-surface: #FAFAF5;
  --color-surface-secondary: #F0F0EB;

  --color-text: #20211F;
  --color-text-strong: #141515;
  --color-text-muted: #89867D;
  --color-text-on-dark: #F5F2EB;

  --color-button-bg: #596354;
  --color-button-text: #FFFFFF;
  --color-button-hover: #3F473C;

  --color-accent: #CBB995;
  --color-border: #D8D8D2;

  /* --- Fonts --- */
  --font-heading: 'Fraunces', Georgia, serif;
  --font-body: 'Inter', -apple-system, sans-serif;
  --font-accent: 'Caveat', cursive;

  /* --- Spacing scale --- */
  --space-xs: 0.5rem;
  --space-sm: 1rem;
  --space-md: 1.5rem;
  --space-lg: 2.5rem;
  --space-xl: 4rem;
  --space-2xl: 6rem;

  /* --- Radius --- */
  --radius-sm: 6px;
  --radius-md: 12px;
  --radius-lg: 20px;
}

/* --- Dark mode overrides --- */
:root[data-theme="dark"] {
  --color-bg: #141515;
  --color-bg-dark: #0A0B0B;
  --color-surface: #20211F;
  --color-surface-secondary: #1B1C1B;

  --color-text: #F5F2EB;
  --color-text-strong: #FFFFFF;
  --color-text-muted: #89867D;
  --color-text-on-dark: #F5F2EB;

  --color-button-bg: #596354;
  --color-button-text: #FFFFFF;
  --color-button-hover: #3F473C;

  --color-accent: #CBB995;
  --color-border: #343532;
}

/* Smooth transition when switching themes */
body {
  transition: background-color 0.2s ease, color 0.2s ease;
}

/* --- Reset basics --- */
*, *::before, *::after {
  box-sizing: border-box;
}

html, body {
  margin: 0;
  padding: 0;
}

body {
  background-color: var(--color-bg);
  color: var(--color-text);
  font-family: var(--font-body);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

h1, h2, h3, h4 {
  font-family: var(--font-heading);
  font-weight: 600;
  line-height: 1.15;
  margin: 0 0 var(--space-sm) 0;
  color: var(--color-text);
}

p {
  margin: 0 0 var(--space-sm) 0;
}

a {
  color: inherit;
  text-decoration: none;
}

img {
  max-width: 100%;
  display: block;
}

/* --- Utility: visually-hidden (for accessibility labels) --- */
.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
}


/* ==========================================================================
   BUTTONS
   ========================================================================== */

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 0.95rem;
  padding: 0.75rem 1.5rem;
  border-radius: var(--radius-sm);
  border: 1px solid transparent;
  cursor: pointer;
  transition: opacity 0.15s ease, background-color 0.15s ease;
  text-decoration: none;
}

.btn-solid {
  background-color: var(--color-button-bg);
  color: var(--color-button-text);
}

.btn-solid:hover {
  opacity: 0.85;
}

.btn-outline {
  background-color: transparent;
  color: var(--color-text);
  border-color: var(--color-text);
}

.btn-outline:hover {
  background-color: var(--color-text);
  color: var(--color-button-text);
}

.btn-sm {
  padding: 0.5rem 1rem;
  font-size: 0.85rem;
}
