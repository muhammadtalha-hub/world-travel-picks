---
import { getCollection } from "astro:content";
import { getCardDisplayTags } from "../utils/articles";

const allArticles = await getCollection("articles", ({ data }) => !data.draft);

const searchData = allArticles.map((article) => ({
  id: article.id,
  title: article.data.title,
  tags: article.data.tags,
  section: article.data.tags[0],
  cardTags: getCardDisplayTags(article),
  image: article.data.coverImage,
  readTime: article.data.readTime,
}));
---

<div
  class="search-results-panel"
  id="search-results-panel"
  data-search={JSON.stringify(searchData)}
>
  <p class="search-empty-hint">
    Start typing to search destinations, guides, and books...
  </p>
</div>

<div class="search-panel-backdrop" id="search-panel-backdrop"></div>

<style>
  .search-panel-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.25);
    z-index: 55;
  }

  .search-panel-backdrop.open {
    display: block;
  }

  .search-results-panel {
    display: none;
    position: fixed;
    top: 76px;
    right: var(--space-md);
    width: 420px;
    max-width: 92vw;
    max-height: 70vh;
    overflow-y: auto;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
    z-index: 61;
    padding: var(--space-sm) var(--space-md) var(--space-md);
  }

  .search-results-panel.open {
    display: block;
  }

  .search-empty-hint {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    text-align: center;
    padding: var(--space-lg) 0;
  }

  .search-group {
    margin-top: var(--space-md);
  }

  .search-group-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-xs);
  }

  .search-group-header h4 {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .search-group-header a {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .search-group-header a:hover {
    color: var(--color-text);
  }

  .search-result-item {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 0.5rem 0.3rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
  }

  .search-result-item:hover {
    background-color: var(--color-surface-secondary);
  }

  .search-result-item img {
    width: 44px !important;
    min-width: 44px !important;
    max-width: 44px !important;
    height: 44px !important;
    min-height: 44px !important;
    max-height: 44px !important;
    object-fit: cover !important;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
    display: block;
  }

  .search-result-item {
    flex-direction: row !important;
  }

  .search-result-item .result-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
  }

  .search-result-item .result-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .search-result-item .result-meta {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .search-view-all {
    display: block;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
    padding: var(--space-sm);
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-sm);
  }

  .search-no-results {
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    padding: var(--space-lg) 0;
  }

  /* Mobile: panel becomes full-width, sits right under the takeover search bar */
  @media (max-width: 700px) {
    .search-results-panel {
      top: 60px;
      right: 0;
      left: 0;
      width: 100%;
      max-width: 100%;
      max-height: calc(100vh - 60px);
      border-radius: 0;
      border-left: none;
      border-right: none;
      padding: var(--space-sm) var(--space-sm) var(--space-md);
    }

    .search-result-item {
      gap: 0.6rem;
      padding: 0.5rem 0.2rem;
    }

    .search-result-item .result-title {
      font-size: 0.8rem;
    }

    .search-result-item .result-meta {
      font-size: 0.7rem;
    }
  }
</style>

<script>
  type SearchItem = {
    id: string;
    title: string;
    tags: string[];
    section: string;
    cardTags: string[];
    image: string;
    readTime: string;
  };

  const panel = document.getElementById("search-results-panel");
  const backdrop = document.getElementById("search-panel-backdrop");

  let searchData: SearchItem[] = [];
  try {
    searchData = JSON.parse(panel?.getAttribute("data-search") || "[]");
  } catch {
    searchData = [];
  }

  function performSearch(query: string): SearchItem[] {
    const lowerQuery = query.toLowerCase().trim();
    if (!lowerQuery) return [];
    return searchData.filter((item) => {
      const titleMatch = item.title.toLowerCase().includes(lowerQuery);
      const tagMatch = item.tags.some((tag) =>
        tag.toLowerCase().includes(lowerQuery),
      );
      return titleMatch || tagMatch;
    });
  }

  function escapeHtml(str: string): string {
    const div = document.createElement("div");
    div.textContent = str;
    return div.innerHTML;
  }

  function renderResults(query: string) {
    if (!panel) return;

    if (!query.trim()) {
      panel.innerHTML =
        '<p class="search-empty-hint">Start typing to search destinations, guides, and books...</p>';
      return;
    }

    const results = performSearch(query);

    if (results.length === 0) {
      panel.innerHTML = `<p class="search-no-results">No results found for "${escapeHtml(query)}".</p>`;
      return;
    }

    const groups: Record<string, SearchItem[]> = {
      Guides: [],
      Books: [],
      Destinations: [],
    };
    results.forEach((item) => {
      if (groups[item.section]) groups[item.section].push(item);
    });

    const sectionLinks: Record<string, string> = {
      Guides: "/guides",
      Books: "/books",
      Destinations: "/destinations",
    };

    let html = "";
    for (const [sectionName, items] of Object.entries(groups)) {
      if (items.length === 0) continue;
      const topItems = items.slice(0, 3);
      html += `
        <div class="search-group">
          <div class="search-group-header">
            <h4>${sectionName === "Guides" ? "Top Guides" : sectionName}</h4>
            <a href="${sectionLinks[sectionName]}">View All ${sectionName} →</a>
          </div>
          ${topItems
            .map(
              (item) => `
            <a href="/articles/${item.id}" class="search-result-item">
              <img src="${item.image}" alt="${escapeHtml(item.title)}" />
              <div class="result-text">
                <span class="result-title">${escapeHtml(item.title)}</span>
                <span class="result-meta">${escapeHtml(item.cardTags.join(" · "))}</span>
              </div>
            </a>
          `,
            )
            .join("")}
        </div>
      `;
    }

    html += `<a href="/search?q=${encodeURIComponent(query)}" class="search-view-all">View all results for "${escapeHtml(query)}" →</a>`;

    panel.innerHTML = html;
  }

  function openPanel() {
    panel?.classList.add("open");
    backdrop?.classList.add("open");
  }

  function closePanel() {
    panel?.classList.remove("open");
    backdrop?.classList.remove("open");
  }

  backdrop?.addEventListener("click", closePanel);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closePanel();
  });

  // Close when clicking anywhere outside the panel or the search input itself.
  document.addEventListener("click", (e) => {
    const target = e.target as Node;
    const clickedInsidePanel = panel?.contains(target);
    const clickedSearchInput = (target as HTMLElement).closest(
      "#header-search-wrap, .hero-search",
    );
    if (
      panel?.classList.contains("open") &&
      !clickedInsidePanel &&
      !clickedSearchInput
    ) {
      closePanel();
    }
  });

  // Exposed globally: Header.astro and Hero.astro call these directly.
  (window as any).__searchPanel = { openPanel, closePanel, renderResults };
</script>
</file>

