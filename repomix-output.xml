                    </a>
                  ))}
                </div>
              </div>
            </div>
          )
        }
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .article-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: var(--space-md);
  }

  .breadcrumbs {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .breadcrumbs a {
    color: var(--color-text-muted);
  }
  .breadcrumbs a:hover {
    color: var(--color-text);
  }
  .breadcrumbs .current {
    color: var(--color-text);
  }

  .article-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: var(--space-lg);
    align-items: start;
  }

  .tag-pill {
    display: inline-block;
    background-color: var(--color-accent);
    color: var(--color-text-strong);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-xs);
  }

  .article-main h1 {
    font-size: 2rem;
    margin-bottom: var(--space-xs);
  }
  .article-desc {
    color: var(--color-text-muted);
    font-size: 1rem;
    margin-bottom: var(--space-sm);
  }

  .article-meta {
    display: flex;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .progress-track {
    height: 4px;
    background-color: var(--color-border);
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: var(--space-md);
  }

  .progress-fill {
    height: 100%;
    width: 0%;
    background-color: var(--color-button-bg);
    transition: width 0.1s ease;
  }

  .article-cover {
    width: 100%;
    border-radius: var(--radius-md);
    margin-bottom: var(--space-md);
  }

  .article-body {
    font-size: 1rem;
    line-height: 1.75;
  }
  .article-body :global(h2) {
    font-size: 1.4rem;
    margin-top: var(--space-lg);
  }
  .article-body :global(p) {
    color: var(--color-text);
    margin-bottom: var(--space-sm);
  }

  /* Blockquotes (pull quotes) — theme-aware, both light & dark */
  .article-body :global(blockquote) {
    background-color: var(--color-surface-secondary);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-sm);
    padding: var(--space-sm) var(--space-md);
    margin: var(--space-md) 0;
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--color-text);
  }

  .article-body :global(blockquote p) {
    margin: 0;
  }

  /* Travel Tip callout box */
  .travel-tip {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    background-color: var(--color-surface-secondary);
    border-radius: var(--radius-md);
    padding: var(--space-sm) var(--space-md);
    margin: var(--space-md) 0;
    font-size: 0.9rem;
  }

  .travel-tip .tip-icon {
    flex-shrink: 0;
    font-size: 1.2rem;
  }
  .travel-tip strong {
    color: var(--color-text-strong);
  }
  .travel-tip p {
    margin: 0;
    color: var(--color-text);
  }

  /* Travel Info box (Best Time, Language, Currency, Time Zone) */
  .travel-info {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-sm);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-sm) var(--space-md);
    margin: var(--space-md) 0;
  }

  .travel-info-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .travel-info-item .label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text-muted);
  }
  .travel-info-item .value {
    font-size: 0.85rem;
    color: var(--color-text);
  }

  @media (max-width: 600px) {
    .travel-info {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .prev-next-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .prev-next-link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    max-width: 45%;
  }
  .prev-next-link.next {
    text-align: right;
    margin-left: auto;
  }
  .prev-next-link span {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
  .prev-next-link strong {
    font-size: 0.9rem;
    color: var(--color-text);
  }

  /* --- Sidebar (desktop) --- */
  .article-sidebar {
    position: sticky;
    top: calc(var(--space-md) + 60px);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .sidebar-box {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-md);
  }

  .sidebar-box h4 {
    font-size: 0.9rem;
    margin-bottom: var(--space-sm);
  }

  .author-row {
    display: flex;
    gap: var(--space-sm);
    align-items: flex-start;
  }
  .author-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: var(--color-button-bg);
    color: var(--color-button-text);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    flex-shrink: 0;
  }
  .author-row strong {
    font-size: 0.85rem;
    display: block;
    margin-bottom: 0.2rem;
  }
  .author-row p {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .toc-box nav {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .toc-box nav a {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  .toc-box nav a:hover,
  .toc-box nav a.active {
    color: var(--color-accent);
    font-weight: 600;
  }

  .share-icons {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .copy-confirm {
    display: none;
    font-size: 0.8rem;
    color: var(--color-button-bg);
    margin-top: 0.5rem;
  }

  .copy-confirm.show {
    display: block;
  }
  .share-icon {
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-surface-secondary);
    border-radius: 50%;
    color: var(--color-text);
  }

  .related-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .related-item {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
  }
  .related-item img {
    width: 56px;
    height: 56px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }
  .related-item span {
    font-size: 0.82rem;
    color: var(--color-text);
    font-weight: 600;
    display: block;
  }
  .related-item small {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  /* --- Mobile: sidebar becomes accordions below the article --- */
  @media (max-width: 950px) {
    .article-layout {
      grid-template-columns: 1fr;
    }

    .article-sidebar {
      position: static;
    }

    /* TOC is explicitly dropped on mobile, per instructions */
    .toc-box {
      display: none;
    }

    .sidebar-box {
      border: none;
      border-top: 1px solid var(--color-border);
      border-radius: 0;
      padding: var(--space-sm) 0;
    }

    .sidebar-box h4 {
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      margin-bottom: 0;
    }

    .sidebar-box h4::after {
      content: "›";
      font-size: 1.3rem;
      transform: rotate(90deg);
      transition: transform 0.2s ease;
    }

    .sidebar-box.open h4::after {
      transform: rotate(270deg);
    }

    .sidebar-box .accordion-content {
      display: none;
      margin-top: var(--space-sm);
    }

    .sidebar-box.open .accordion-content {
      display: block;
    }
  }
</style>

<script>
  // Reading progress bar
  const progressFill = document.getElementById("reading-progress-fill");

  function updateProgress() {
    const scrollTop = window.scrollY;
    const docHeight =
      document.documentElement.scrollHeight - window.innerHeight;
    const percent = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
    if (progressFill) {
      progressFill.style.width = `${Math.min(percent, 100)}%`;
    }
  }

  // Highlights the current section in the Table of Contents as you scroll
  function updateActiveToc() {
    const headings = document.querySelectorAll(".article-body h2[id]");
    const tocLinks = document.querySelectorAll("#toc-nav a");
    let currentSlug = "";

    headings.forEach((heading) => {
      const rect = heading.getBoundingClientRect();
      if (rect.top < 150) {
        currentSlug = heading.id;
      }
    });

    tocLinks.forEach((link) => {
      link.classList.toggle(
        "active",
        link.getAttribute("data-slug") === currentSlug,
      );
    });
  }

  window.addEventListener("scroll", () => {
    updateProgress();
    updateActiveToc();
  });
  updateProgress();
  updateActiveToc();

  // Mobile accordion toggles (Author / Share / Related sidebar boxes)
  document.querySelectorAll(".sidebar-box").forEach((box) => {
    const heading = box.querySelector("h4");
    heading?.addEventListener("click", () => {
      if (window.innerWidth <= 950) {
        box.classList.toggle("open");
      }
    });
  });

  // --- Real sharing functionality ---
  const pageUrl = window.location.href;
  const pageTitle = document.title;

  const whatsappBtn = document.getElementById("share-whatsapp");
  if (whatsappBtn) {
    whatsappBtn.setAttribute(
      "href",
      `https://wa.me/?text=${encodeURIComponent(pageTitle + " " + pageUrl)}`,
    );
    whatsappBtn.setAttribute("target", "_blank");
    whatsappBtn.setAttribute("rel", "noopener noreferrer");
  }

  const facebookBtn = document.getElementById("share-facebook");
  if (facebookBtn) {
    facebookBtn.setAttribute(
      "href",
      `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`,
    );
    facebookBtn.setAttribute("target", "_blank");
    facebookBtn.setAttribute("rel", "noopener noreferrer");
  }

  const pinterestBtn = document.getElementById("share-pinterest");
  if (pinterestBtn) {
    const coverImg = document.querySelector(
      ".article-cover",
    ) as HTMLImageElement;
    const imageUrl = coverImg?.src || "";
    pinterestBtn.setAttribute(
      "href",
      `https://pinterest.com/pin/create/button/?url=${encodeURIComponent(pageUrl)}&media=${encodeURIComponent(imageUrl)}&description=${encodeURIComponent(pageTitle)}`,
    );
    pinterestBtn.setAttribute("target", "_blank");
    pinterestBtn.setAttribute("rel", "noopener noreferrer");
  }

  const xBtn = document.getElementById("share-x");
  if (xBtn) {
    xBtn.setAttribute(
      "href",
      `https://twitter.com/intent/tweet?text=${encodeURIComponent(pageTitle)}&url=${encodeURIComponent(pageUrl)}`,
    );
    xBtn.setAttribute("target", "_blank");
    xBtn.setAttribute("rel", "noopener noreferrer");
  }

  const copyBtn = document.getElementById("share-copy");
  const copyConfirm = document.getElementById("copy-confirm");
  copyBtn?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(pageUrl);
      copyConfirm?.classList.add("show");
      setTimeout(() => copyConfirm?.classList.remove("show"), 2000);
    } catch (err) {
      console.error("Could not copy link:", err);
    }
  });

  // Native share button — only show it if the browser/device actually supports it
  // (mainly mobile devices; most desktop browsers don't have this).
  const nativeBtn = document.getElementById("share-native");
  if (nativeBtn) {
    if (navigator.share) {
      nativeBtn.addEventListener("click", () => {
        navigator.share({ title: pageTitle, url: pageUrl }).catch(() => {});
      });
    } else {
      nativeBtn.style.display = "none";
    }
  }
</script>
</file>

<file path="src/pages/destinations.astro">
---
import BaseLayout from "../layouts/BaseLayout.astro";
import ListingHero from "../components/ListingHero.astro";
import ListingFilterBar from "../components/ListingFilterBar.astro";
import Card from "../components/Card.astro";
import ComingSoon from "../components/ComingSoon.astro";
import { getArticlesBySection, getCardDisplayTags } from "../utils/articles";
import heroDestinationsImage from "../assets/images/hero-destinations.jpg";

const articles = await getArticlesBySection("Destinations");

// Sort newest-first by default. The client-side script below re-sorts
// when the visitor changes the Sort dropdown.
const sortedArticles = [...articles].sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const hasArticles = sortedArticles.length > 0;
---

<BaseLayout title="Destinations — World Travel Picks">
  <ListingHero
    eyebrow="Destinations"
    heading="Explore the World"
    description="Discover countries, cities, and hidden gems around the globe. Research, plan, and be inspired for your next adventure."
    imageUrl={heroDestinationsImage}
    imageAlt="A scenic mountain landscape representing world destinations"
  />

  <ListingFilterBar />

  <section class="listing-content">
    {
      hasArticles ? (
        <>
          <p class="listing-count" id="listing-count">
            Showing {sortedArticles.length} of {sortedArticles.length}{" "}
            destinations
          </p>

          <div class="listing-grid" id="listing-grid">
            {sortedArticles.map((article) => (
              <div
                class="listing-card-wrap"
                data-title={article.data.title.toLowerCase()}
                data-tags={getCardDisplayTags(article).join(" ").toLowerCase()}
                data-date={article.data.publishDate.toISOString()}
              >
                <Card
                  image={article.data.coverImage}
                  tag={getCardDisplayTags(article).join(" · ")}
                  title={article.data.title}
                  meta={`${article.data.readTime} · ${article.data.publishDate.toDateString()}`}
                  href={`/articles/${article.id}`}
                />
              </div>
            ))}
          </div>

          <p class="no-results-msg" id="no-results-msg" style="display: none;">
            No destinations match your search.
          </p>
        </>
      ) : (
        <ComingSoon
          title="Destinations Coming Soon"
          message="We're researching amazing destinations for you. Check back soon!"
        />
      )
    }
  </section>
</BaseLayout>

<style>
  .listing-content {
    max-width: 1400px;
    margin: 0 auto;
    padding: var(--space-md);
  }

  .listing-count {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .listing-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-sm);
  }

  .listing-grid.view-list {
    grid-template-columns: 1fr;
  }

  .listing-grid.view-list .listing-card-wrap :global(.card) {
    display: flex;
    flex-direction: row;
    align-items: stretch;
  }

  .listing-grid.view-list .listing-card-wrap :global(.card-image-wrap) {
    width: 240px;
    flex-shrink: 0;
    aspect-ratio: auto;
  }

  .listing-grid.view-list .listing-card-wrap :global(.card-body) {
    flex: 1;
  }

  @media (max-width: 700px) {
    .listing-grid.view-list .listing-card-wrap :global(.card) {
      flex-direction: column;
    }
    .listing-grid.view-list .listing-card-wrap :global(.card-image-wrap) {
      width: 100%;
    }
  }

  .no-results-msg {
    text-align: center;
    color: var(--color-text-muted);
    padding: var(--space-xl) 0;
  }

  @media (max-width: 1100px) {
    .listing-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .listing-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Listens for the events ListingFilterBar dispatches, and applies
  // real search filtering + sorting to the cards already rendered above.
  // (No re-fetching data — we just show/hide and reorder what's there.)

  const grid = document.getElementById("listing-grid");
  const countLabel = document.getElementById("listing-count");
  const noResultsMsg = document.getElementById("no-results-msg");

  function getCardWraps(): HTMLElement[] {
    return grid ? Array.from(grid.querySelectorAll(".listing-card-wrap")) : [];
  }

  function applySearch(query: string) {
    const cards = getCardWraps();
    const lowerQuery = query.toLowerCase().trim();
    let visibleCount = 0;

    cards.forEach((card) => {
      const title = card.dataset.title || "";
      const tags = card.dataset.tags || "";
      const matches =
        !lowerQuery || title.includes(lowerQuery) || tags.includes(lowerQuery);
      card.style.display = matches ? "" : "none";
      if (matches) visibleCount++;
    });

    if (countLabel) {
      countLabel.textContent = `Showing ${visibleCount} of ${cards.length} destinations`;
    }
    if (noResultsMsg) {
      noResultsMsg.style.display = visibleCount === 0 ? "block" : "none";
    }
  }

  function applySort(order: string) {
    if (!grid) return;
    const cards = getCardWraps();
    cards.sort((a, b) => {
      const dateA = new Date(a.dataset.date || "").getTime();
      const dateB = new Date(b.dataset.date || "").getTime();
      return order === "oldest" ? dateA - dateB : dateB - dateA;
    });
    cards.forEach((card) => grid.appendChild(card));
  }

  document.addEventListener("listing-search-change", ((e: CustomEvent) => {
    applySearch(e.detail);
  }) as EventListener);

  document.addEventListener("listing-sort-change", ((e: CustomEvent) => {
    applySort(e.detail);
  }) as EventListener);

  document.addEventListener("listing-region-change", ((e: CustomEvent) => {
    const region = e.detail.toLowerCase();
    const cards = getCardWraps();
    let visibleCount = 0;

    cards.forEach((card) => {
      const tags = card.dataset.tags || "";
      const matches = region === "all regions" || tags.includes(region);
      card.style.display = matches ? "" : "none";
      if (matches) visibleCount++;
    });

    if (countLabel) {
      countLabel.textContent = `Showing ${visibleCount} of ${cards.length} destinations`;
    }
    if (noResultsMsg) {
      noResultsMsg.style.display = visibleCount === 0 ? "block" : "none";
    }
  }) as EventListener);

  document.addEventListener("listing-view-change", ((e: CustomEvent) => {
    grid?.classList.toggle("view-list", e.detail === "list");
  }) as EventListener);
</script>
</file>

