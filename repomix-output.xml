  const heroSearchBtn = document.getElementById("hero-search-btn");

  heroSearchInput?.addEventListener("input", () => {
    const query = heroSearchInput.value;
    if (query.trim()) {
      (window as any).__searchPanel?.openPanel();
      (window as any).__searchPanel?.renderResults(query);
    } else {
      (window as any).__searchPanel?.closePanel();
