<file path="src/pages/articles/[...slug].astro">
---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import {
  getCardDisplayTags,
  getArticlesBySection,
  type Section,
} from "../../utils/articles";

// This function tells Astro exactly which pages to generate —
// one for every article in our content collection.
export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);

const section = article.data.tags[0] as Section;
const displayTags = getCardDisplayTags(article);

// Related articles: same section, excluding this one, max 3.
const sectionArticles = await getArticlesBySection(section);
const relatedArticles = sectionArticles
  .filter((a) => a.id !== article.id)
  .slice(0, 3);

// Breadcrumb label per section, matching the site's naming.
const sectionLabels: Record<Section, string> = {
  Destinations: "Destinations",
  Guides: "Guides",
  Books: "Books",
};
const sectionHref: Record<Section, string> = {
  Destinations: "/destinations",
  Guides: "/guides",
  Books: "/books",
};
---

<BaseLayout
  title={`${article.data.title} — World Travel Picks`}
  description={article.data.description}
  image={article.data.coverImage}
>
  <div class="article-page">
    <nav class="breadcrumbs">
      <a href="/">Home</a>
      <span>/</span>
      <a href={sectionHref[section]}>{sectionLabels[section]}</a>
      <span>/</span>
      <span class="current">{article.data.title}</span>
    </nav>

    <div class="article-layout">
      <main class="article-main">
        {displayTags[0] && <span class="tag-pill">{displayTags[0]}</span>}
        <h1>{article.data.title}</h1>
        <p class="article-desc">{article.data.description}</p>

        <div class="article-meta">
          <span>{article.data.readTime}</span>
          <span>·</span>
          <span>{article.data.publishDate.toDateString()}</span>
          <span>·</span>
          <span>By {article.data.author}</span>
        </div>

        <div class="progress-track">
          <div class="progress-fill" id="reading-progress-fill"></div>
        </div>

        <img
          src={article.data.coverImage}
          alt={article.data.title}
          class="article-cover"
        />

        {
          section !== "Books" && article.data.quickFacts && (
            <div class="travel-info">
              {article.data.quickFacts.bestTimeToVisit && (
                <div class="travel-info-item">
                  <span class="label">Best Time to Visit</span>
                  <span class="value">
                    {article.data.quickFacts.bestTimeToVisit}
                  </span>
                </div>
              )}
              {article.data.quickFacts.language && (
                <div class="travel-info-item">
                  <span class="label">Language</span>
                  <span class="value">{article.data.quickFacts.language}</span>
                </div>
              )}
              {article.data.quickFacts.currency && (
                <div class="travel-info-item">
                  <span class="label">Currency</span>
                  <span class="value">{article.data.quickFacts.currency}</span>
                </div>
              )}
              {article.data.quickFacts.timeZone && (
                <div class="travel-info-item">
                  <span class="label">Time Zone</span>
                  <span class="value">{article.data.quickFacts.timeZone}</span>
                </div>
              )}
            </div>
          )
        }

        {
          section !== "Books" && (
            <div class="travel-tip">
              <span class="tip-icon">💡</span>
              <p>
                <strong>Travel Tip:</strong> Research local customs and
                transportation options before you go — it'll save you time and
                make your trip smoother.
              </p>
            </div>
          )
        }

        <div class="article-body">
          <Content />
        </div>

        <div class="prev-next-row">
          {
            relatedArticles[0] && (
              <a
                href={`/articles/${relatedArticles[0].id}`}
                class="prev-next-link prev"
              >
                <span>← Previous Article</span>
                <strong>{relatedArticles[0].data.title}</strong>
              </a>
            )
          }
          {
            relatedArticles[1] && (
              <a
                href={`/articles/${relatedArticles[1].id}`}
                class="prev-next-link next"
              >
                <span>Next Article →</span>
                <strong>{relatedArticles[1].data.title}</strong>
              </a>
            )
          }
        </div>
      </main>

      <aside class="article-sidebar">
        <div class="sidebar-box author-box">
          <h4>About the Author</h4>
          <div class="accordion-content">
            <div class="author-row">
              <div class="author-avatar">{article.data.author.charAt(0)}</div>
              <div>
                <strong>{article.data.author}</strong>
                <p>Sharing research-driven travel stories and guides.</p>
              </div>
            </div>
          </div>
        </div>

        {
          headings.length > 0 && (
            <div class="sidebar-box toc-box">
              <h4>Table of Contents</h4>
              <nav id="toc-nav">
                {headings
                  .filter((h) => h.depth === 2)
                  .map((heading, i) => (
                    <a href={`#${heading.slug}`} data-slug={heading.slug}>
                      {String(i + 1).padStart(2, "0")}. {heading.text}
                    </a>
                  ))}
              </nav>
            </div>
          )
        }

        <div class="sidebar-box share-box">
          <h4>Share this article</h4>
          <div class="accordion-content">
            <div class="share-icons">
              <a
                href="#"
                class="share-icon"
                id="share-whatsapp"
                aria-label="Share on WhatsApp"
              >
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M17.5 14.4c-.3-.1-1.7-.9-2-1-.3-.1-.5-.1-.6.1-.2.3-.7 1-.9 1.1-.1.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.5-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6l.4-.5c.1-.1.2-.3.2-.4.1-.2 0-.3 0-.5l-.9-2.1c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.1 4.9 4.3.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.7-.7 2-1.4.2-.7.2-1.2.2-1.4 0-.1-.2-.2-.5-.3ZM12 2a10 10 0 0 0-8.6 15L2 22l5.1-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.6 0-3.1-.4-4.4-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 20.2 12 8.2 8.2 0 0 1 12 20.2Z"
                  ></path></svg
                >
              </a>
              <a
                href="#"
                class="share-icon"
                id="share-facebook"
                aria-label="Share on Facebook"
              >
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12Z"
                  ></path></svg
                >
              </a>
              <a
                href="#"
                class="share-icon"
                id="share-pinterest"
                aria-label="Share on Pinterest"
              >
                <svg
